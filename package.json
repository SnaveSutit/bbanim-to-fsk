		"esbuild-plugin-svelte": "^0.1.1",
		"esbuild": "^0.17.10",
		"eslint": "^8.35.0",
		"prettier": "^2.5.1",
		"svelte-preprocess-esbuild": "^3.0.1",
		"svelte-preprocess": "^5.0.1",
		"svelte": "^3.55.1",
		"ts-loader": "^9.2.6",
		"typescript": "^4.5.5",
		"vue": "^3.2.33"
	},
